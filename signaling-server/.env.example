# ─────────────────────────────────────────────────────────────────────────────
# Quick-Share signaling server — environment template
# Copy to `.env` (gitignored) and fill in real values:
#   cp .env.example .env
# On Render, set these in Dashboard → Service → Environment instead.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
PORT=3002

# MongoDB Atlas connection string (Stored Mode). Omit to run live-only (P2P).
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority

# Comma-separated frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# ── AI / RAG ──────────────────────────────────────────────────────────────────
# Groq free-tier key — enables grounded AI answers. Without it the server runs
# in retrieval-only mode (/ai/query returns sources with ai_not_configured).
# MUST be set in the hosting dashboard for production (.env is gitignored).
GROQ_API_KEY=gsk_your_free_groq_key
GROQ_MODEL=openai/gpt-oss-120b

# Master switch for the RAG layer.
RAG_ENABLED=true

# ── External embedding providers (OPTIONAL — the ≤480MB Render guarantee) ────
# When keys are present, these serve BEFORE the local model and the ONNX
# weights never download/load on small hosts. Circuit breaker + generation
# stamping apply automatically; local BGE stays as last-resort fallback
# (subject to RAG_ALLOW_LOCAL_TINY below).
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-v4.0
COHERE_EMBED_DIM=1536
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-4-lite
VOYAGE_EMBED_DIM=1024
RAG_PROVIDER_ORDER=cohere,voyage,local
RAG_PROVIDER_TIMEOUT_MS=20000
RAG_PROVIDER_MIN_INTERVAL_MS=250

# ── Adaptive memory tiers ─────────────────────────────────────────────────────
# The server auto-detects its cgroup memory limit at boot:
#   TINY <768MB · STANDARD ≤2048MB · LARGE >2048MB
# and adjusts ceilings/thresholds itself. Override only if detection is wrong:
INSTANCE_MEMORY_MB=

# Local ONNX embedder on TINY hosts: OFF by default (native inference cannot
# be guaranteed under a 480MB target). Opt in deliberately at your own risk.
RAG_ALLOW_LOCAL_TINY=false
# Or disable local everywhere (APIs only):
RAG_DISABLE_LOCAL=false

# Direct-stuffing budget derives from the ACTIVE Groq model's context window
# (~25% of tokens; conservative 3 chars/token char-gate). Override both to tune:
LLM_CONTEXT_TOKENS=131072
RAG_DIRECT_STUFF_MAX_TOKENS=98304
RAG_DIRECT_STUFF_CHARS=

# Emergency kill switch: force EVERY corpus through direct stuffing so the
# local embedder can never load (stronger than RAG_DISABLE_LOCAL).
RAG_FORCE_DIRECT=false

# Total-process RSS ceiling for TINY hosts (MB) — jobs PAUSE above it.
RAG_EMBED_MAX_RSS_MB=384

# Resume indexing from durable per-chunk work units after a crash or provider
# failure — no re-extraction/re-chunking of source files.
RAG_RESUME_ENABLED=true

# Embedding-provider circuit breaker: open after N consecutive failures,
# admit one half-open probe after the cooldown.
RAG_BREAKER_THRESHOLD=3
RAG_BREAKER_COOLDOWN_MS=30000

# Local embedding model + ONNX quantization (q8 ≈ 25MB weights, low RAM).
# Weights download lazily on first vector-mode index only.
RAG_EMBED_MODEL=Xenova/bge-small-en-v1.5
RAG_EMBED_DTYPE=q8

# Indexing tuning (defaults are tuned for 512MB hosts — change with care).
RAG_EMBED_BATCH=16
RAG_MONGO_INSERT_BATCH=100
RAG_MAX_CHUNKS=4000
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=90

# LRU cap on in-memory retrieval indexes (chunks + vectors per cached session).
RAG_INDEX_CACHE_MAX=12

# Cross-encoder reranker adds ~400MB resident RAM — leave false on 512MB tiers.
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=Xenova/bge-reranker-base

# Optional: cache dir for ONNX weights (useful in CI; leave unset on Render —
# its disk is ephemeral).
# HF_CACHE_DIR=/path/to/hf-cache

# ── Misc / optional ───────────────────────────────────────────────────────────
# Session time-to-live for live (P2P signaling) sessions. Default 24h.
SESSION_TTL_MS=86400000

# TURN credentials via metered.ca for NAT-traversal (optional).
METERED_API_KEY=

# Bearer key protecting GET /stats (optional).
STATS_KEY=

# Set true ONLY if your MongoDB endpoint has a broken TLS chain.
MONGODB_TLS_INSECURE=false

# Recommended on 512MB hosts: force V8 to GC before the container OOMs.
# Render "Environment" → NODE_OPTIONS=--max-old-space-size=384
